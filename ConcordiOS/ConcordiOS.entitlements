<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Network Extension: the main app declares packet-tunnel-provider
	     too, like FlClash's Runner does. This matters for the unsigned
	     IPA: tools/adhoc-sign.sh embeds these entitlements into the
	     binaries' ad-hoc signatures so a re-signer (SideKite/zsign)
	     preserves them; without it installd rejects the tunnel. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- SSID 直连覆盖 (v0.2.43 C1): the app reads the current Wi-Fi
	     SSID (NEHotspotNetwork) on the On-Demand page. Same key the
	     fork carries in both Runner.entitlements and
	     NECore.entitlements. Safe to declare: tools/adhoc-sign.sh
	     copies the whole entitlements dict into the ad-hoc signature
	     (no whitelist), and the JUMJJ8 profile verified 2026-11-20
	     contains wifi-info, so the re-signer preserves it. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.434fff4c253add77.1</string>
	</array>
</dict>
</plist>
