    "disclaimer.restatement": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本软件自身不提供任何代理服务器、节点、订阅、机场或网络接入服务，也不与任何此类服务的提供者存在合作、代理或担保关系。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not provide any proxy servers, nodes, subscriptions, airports, or network access services, nor does it cooperate with, act as an agent for, or endorse any provider of such services."
          }
        }
      }
    },
    "disclaimer.intro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用 FlClash（以下简称“本软件”）前，请仔细阅读并充分理解本声明。点击“同意”表示你已阅读并理解以下内容；如不想继续，可点击“退出”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before using FlClash (hereinafter “the App”), please read and fully understand this disclaimer. Tapping “Agree” means you have read and understood the following; if you do not wish to continue, tap “Exit”."
          }
        }
      }
    },
    "disclaimer.terms.nature.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件性质"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nature of the App"
          }
        }
      }
    },
    "disclaimer.terms.nature.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本软件是基于 Concord 内核的开源网络代理客户端，仅提供配置管理、规则分流与流量转发等本地工具功能。\n\n本软件自身不提供任何代理服务器、节点、订阅、机场或网络接入服务，也不与任何此类服务的提供者存在合作、代理或担保关系。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is an open-source network proxy client based on the Concord core, providing only local tooling such as configuration management, rule-based routing, and traffic forwarding.\n\nThis app does not provide any proxy servers, nodes, subscriptions, airports, or network access services, nor does it cooperate with, act as an agent for, or endorse any provider of such services."
          }
        }
      }
    },
    "disclaimer.terms.usage.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用说明"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage"
          }
        }
      }
    },
    "disclaimer.terms.usage.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人基于本软件开展的商业活动，包括付费分发、捆绑销售或作为商业服务的组成部分，均与本软件的开发者无关，开发者不为其提供背书、支持或担保。\n\n你须自行遵守所在国家或地区的法律法规，因违法使用本软件产生的后果由你自行承担。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any commercial activity based on this app — including paid distribution, bundling, or use as part of a commercial service — has nothing to do with the app's developers, who provide no endorsement, support, or guarantee for it.\n\nYou must comply with the laws and regulations of your country or region; you bear all consequences of any unlawful use of this app."
          }
        }
      }
    },
    "disclaimer.terms.responsibility.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户责任"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User Responsibility"
          }
        }
      }
    },
    "disclaimer.terms.responsibility.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你应自行确认使用本软件在你所在国家或地区是合法的，并对使用本软件的全部行为及其后果独立承担法律责任。\n\n你导入的订阅、节点与配置由你自行选择和判断，其来源是否合法、内容是否安全、服务是否稳定，均由你与相关提供者自行负责。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must confirm for yourself that using this app is lawful in your country or region, and you bear sole legal responsibility for all of your use of this app and its consequences.\n\nSubscriptions, nodes, and configurations you import are chosen and judged by you; whether their sources are lawful, their content safe, and their services stable is your responsibility and that of the relevant providers."
          }
        }
      }
    },
    "disclaimer.terms.thirdparty.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方内容"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-Party Content"
          }
        }
      }
    },
    "disclaimer.terms.thirdparty.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅链接、配置文件、规则集、脚本、外部资源及外部链接均由第三方提供，开发者无法也不会对其合法性、准确性、安全性和可用性进行审查或担保。\n\n因使用第三方内容导致的数据泄露、财产损失、账号封禁或其他任何损失，由你与第三方自行解决，开发者不承担任何责任。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription links, configuration files, rule sets, scripts, external resources, and external links are all provided by third parties; the developers cannot and do not review or guarantee their legality, accuracy, security, or availability.\n\nAny data leak, financial loss, account ban, or other loss arising from third-party content is to be resolved between you and the third party; the developers bear no responsibility."
          }
        }
      }
    },
    "disclaimer.terms.nowarranty.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无担保声明"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Warranty"
          }
        }
      }
    },
    "disclaimer.terms.nowarranty.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本软件按“现状”和“可用”的原则提供，不附带任何明示或默示的担保，包括但不限于适销性、特定用途适用性、不侵权以及持续可用、无错误、无安全漏洞的担保。\n\n开发者不保证本软件能满足你的需求，也不保证本软件的运行不会中断或不会出现错误。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is provided “as is” and “as available”, without any express or implied warranty, including but not limited to merchantability, fitness for a particular purpose, non-infringement, and continuous availability, freedom from errors, or freedom from security vulnerabilities.\n\nThe developers do not guarantee that this app will meet your needs, or that its operation will be uninterrupted or error-free."
          }
        }
      }
    },
    "disclaimer.terms.liability.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "责任限制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitation of Liability"
          }
        }
      }
    },
    "disclaimer.terms.liability.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在适用法律允许的最大范围内，开发者及所有贡献者均不对因使用或无法使用本软件而产生的任何直接、间接、偶然、特殊、惩罚性或后果性损害承担责任，包括但不限于数据丢失、设备损坏、网络异常、业务中断、利润损失或因此引起的任何法律纠纷，即使已被告知发生此类损害的可能性。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To the maximum extent permitted by applicable law, the developers and all contributors shall not be liable for any direct, indirect, incidental, special, punitive, or consequential damages arising from the use of, or inability to use, this app, including but not limited to data loss, device damage, network anomalies, service interruption, loss of profits, or any resulting legal disputes, even if advised of the possibility of such damages."
          }
        }
      }
    },
    "disclaimer.terms.privacy.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据收集与隐私"
