      }
    },
    "disclaimer.terms.privacy.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本软件不会收集或上传你的订阅地址、节点信息、配置内容、访问的网站、连接记录、流量内容和日志，这些数据仅保存在你的设备本地，开发者无法获取。\n\n本软件只会在你使用相应功能时访问外部网络，例如更新订阅时访问你提供的订阅地址、检查更新时访问 GitHub。\n\n本软件在所有平台上均未集成任何数据统计或崩溃上报服务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not collect or upload your subscription URLs, node information, configuration content, visited websites, connection records, traffic content, or logs; this data stays on your device only and the developers cannot access it.\n\nThis app only accesses the network when you use a feature that requires it — for example, visiting your subscription URL when updating a subscription, or GitHub when checking for updates.\n\nThis app integrates no analytics or crash-reporting service on any platform."
          }
        }
      }
    },
    "disclaimer.terms.license.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源协议"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source License"
          }
        }
      }
