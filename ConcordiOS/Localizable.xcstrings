    "disclaimer.terms.license.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本软件以 GPL-3.0 协议开源，你可以依该协议运行、研究、修改和分发本软件；分发本软件或其修改版本时，须同样以 GPL-3.0 协议提供源代码并保留原有的版权声明。\n\n本软件包含的第三方组件（包括 Concord 内核）分别遵循其各自的开源协议。基于本软件修改或分发的版本所产生的任何问题，与原作者无关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is open-source under the GPL-3.0 license; you may run, study, modify, and distribute it under that license, and when distributing this app or modified versions you must likewise provide the source code under GPL-3.0 and retain the original copyright notices.\n\nThird-party components included in this app (including the Concord core) are each governed by their own open-source licenses. Any issues arising from versions modified or distributed based on this app are unrelated to the original authors."
          }
        }
      }
    },
