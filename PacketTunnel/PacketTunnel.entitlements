<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Network Extension: required for NEPacketTunnelProvider.
	     NOTE: this entitlement is normally only available to paid
	     Apple Developer Program members. Verify your provisioning
	     profile actually contains `packet-tunnel-provider` before
	     assuming the signed build will run. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- SSID 直连覆盖 (v0.2.43 C1): the extension reads the current
	     Wi-Fi SSID (NEHotspotNetwork) in SsidDirectController to
	     enforce direct SSIDs without the app running. Same key the
	     fork carries in NECore.entitlements. Safe to declare:
	     tools/adhoc-sign.sh copies the whole entitlements dict into
	     the ad-hoc signature (no whitelist), and the JUMJJ8 profile
	     verified 2026-11-20 contains wifi-info, so the re-signer
	     preserves it. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.434fff4c253add77.1</string>
	</array>
</dict>
</plist>
