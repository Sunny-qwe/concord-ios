+//! Log lines for the iOS core. `eprintln!` is the portable fallback (the
+//! same branch `bins/android/src/logcat.rs` takes off Android); in a
+//! NetworkExtension stderr lands in the system log. A future step could
+//! route these through `os_log` instead.
+
+pub fn info(message: &str) {
+    eprintln!("{message}");
+}
+
+pub fn error(message: &str) {
+    eprintln!("[ERROR] {message}");
+}
