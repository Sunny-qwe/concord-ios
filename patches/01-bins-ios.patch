+++ b/bins/ios/src/platform.rs
@@ -0,0 +1,68 @@
+use std::net::SocketAddr;
+
+use async_trait::async_trait;
+use concord_common::{FlowKey, ProcessInfo, RawSocket};
+use concord_platform::{FdPressure, InterfaceInfo, Platform};
+
+/// What the iOS host answers for the core. There is no `VpnService`-style
+/// host on iOS, so there is no `PlatformHost` trait instance and no
+/// `concord_set_platform_host`: the answers below are the whole platform.
+///
+/// The three Android host callbacks (`bins/android/src/platform.rs`,
+/// `PlatformHost::{protect, resolve_uid, resolve_package}`) have no iOS
+/// equivalent, and each is replaced as follows:
+///
+/// * `protect` — no-op that answers `true`. A NetworkExtension's own
+///   outbound sockets are not routed back into the tunnel by the system, so
+///   there is nothing to exclude; answering `true` also stops the core
+///   retrying the socket on the next TUN start (see `Platform::protect`:
+///   `false` means "owed but could not be done now"). UNVERIFIED: whether an
+///   NE provider's own sockets can ever loop back into the tunnel is not
+///   addressed anywhere in upstream Concord and was not tested here.
+/// * `resolve_uid` / `resolve_package` — no owner info. iOS does not expose
+///   the owning app of a flow to the extension, so `find_owner` returns
+///   `None` and connection lists show no process owner. `FlowKey` owner
+///   lookups are best-effort UI data, not needed for proxying.
+pub struct IosPlatform {
+    pressure: FdPressure,
+}
+
+impl IosPlatform {
+    pub fn new() -> Self {
+        IosPlatform {
+            pressure: FdPressure::new(),
+        }
+    }
+}
+
+impl Default for IosPlatform {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+#[async_trait]
+impl Platform for IosPlatform {
+    fn protect(&self, _socket: RawSocket) -> bool {
+        // No VpnService.protect on iOS; the extension's sockets stay outside
+        // the tunnel by the system. See the struct docs.
+        true
+    }
+
+    async fn find_owner(&self, _flow: &FlowKey) -> Option<ProcessInfo> {
+        // iOS exposes no per-flow owning process to a NetworkExtension.
+        None
+    }
+
+    fn default_interface(&self) -> Option<InterfaceInfo> {
+        None
+    }
+
+    fn system_dns(&self) -> Vec<SocketAddr> {
+        Vec::new()
+    }
+
+    fn fd_pressure(&self) -> bool {
+        self.pressure.should_block()
+    }
+}
