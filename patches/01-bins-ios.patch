index 0000000..e779743
--- /dev/null
+++ b/bins/ios/src/lib.rs
@@ -0,0 +1,38 @@
+//! `libconcord_ios.a`: the Rust core as an iOS static library, for a
+//! `NEPacketTunnelProvider` (NetworkExtension) target. Its C ABI is
+//! `concord_start`, which builds the core, and the session functions of
+//! `concord-ffi` (`concord_open_callback`, `concord_send`, `concord_close`,
+//! `concord_adopt_fd`, plus the packet-channel functions of the Option B
+//! patch). A host binds them to its own runtime; the Swift glue is the host's.
+//!
+//! The JSON-RPC flow is the same as Android's (`bins/android`):
+//! `core.init` (home dir; `sdk_int` stays unset, i.e. 0) → `config.apply` →
+//! `engine.start` → `tun.start`. The TUN source on iOS is either
+//! `{"kind": "inherited", "handle": …}` (a socketpair end adopted with
+//! `concord_adopt_fd`, see `bridge.rs`) or, once the Option B patch is
+//! applied, `{"kind": "channel", "handle": …}` (see `crates/tun/src/channel.rs`).
+//! There is no `{"kind": "device"}` on iOS: the core must not create its own
+//! TUN device inside a NetworkExtension; the system owns the tunnel interface.
+//! `core.hello` reports `"os": "ios"` (via `std::env::consts::OS`, since
+//! `EngineConfig { android: false }`) and capabilities
+//! `["tun.inherited", "tun.channel"]`.
+//!
+//! Everything here is written against the patched tree (Option B patch +
+//! the `TunDevice::wrap` iOS compile fix in `crates/tun/src/device/mod.rs`);
+//! see `bins/ios/README.md`. It has never been compiled for
+//! `aarch64-apple-ios`: BoringSSL / aws-lc-sys under the iphoneos SDK is the
+//! first gate to test on a macOS runner.
+
+#![allow(
+    unsafe_code,
+    reason = "the exported C functions, a descriptor handed over by the host and os_log"
+)]
+
+mod abi;
+pub mod bridge;
+pub mod core;
+mod log;
+pub mod platform;
+
+pub use abi::concord_start;
+pub use bridge::{concord_ios_bridge_close, concord_ios_bridge_open};
