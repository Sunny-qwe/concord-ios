diff --git a/crates/api/src/channels.rs b/crates/api/src/channels.rs
new file mode 100644
index 0000000..185103c
--- /dev/null
+++ b/crates/api/src/channels.rs
@@ -0,0 +1,68 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use concord_common::sync::lock;
+use concord_tun::channel::{ChannelDevice, ChannelNet, channel_pair};
+
+/// Packet channels a host opened for the core and registered before
+/// `tun.start` names them. Mirrors `AdoptedFds`, but for the Option B
+/// channel device: the device half is taken by `tun.start` (once), the net
+/// half stays for `concord_packet_write` / `concord_packet_read` until the
+/// channel is closed. Registering hands over the device half's ownership
+/// only when `tun.start` takes it; closing a channel never stops a runner
+/// that already took its device.
+#[derive(Default)]
+pub struct PacketChannels {
+    next: AtomicU64,
+    held: Mutex<HashMap<u64, ChannelEntry>>,
+}
+
+struct ChannelEntry {
+    device: Option<ChannelDevice>,
+    net: Arc<ChannelNet>,
+}
+
+impl PacketChannels {
+    /// Creates a channel pair and returns its handle (never 0).
+    pub fn create(&self) -> u64 {
+        let handle = self.next.fetch_add(1, Ordering::Relaxed) + 1;
+        let (device, net) = channel_pair();
+        {
+            let mut held = lock(&self.held);
+            held.insert(
+                handle,
+                ChannelEntry {
+                    device: Some(device),
+                    net: Arc::new(net),
+                },
+            );
+        }
+        handle
+    }
+
+    /// Takes the device half for `tun.start`. `None` when the handle is
+    /// unknown or its device was already taken.
+    pub fn take_device(&self, handle: u64) -> Option<ChannelDevice> {
+        lock(&self.held).get_mut(&handle)?.device.take()
+    }
+
+    /// The host half for packet I/O. `None` when the handle is unknown.
+    pub fn net(&self, handle: u64) -> Option<Arc<ChannelNet>> {
+        lock(&self.held).get(&handle).map(|entry| entry.net.clone())
+    }
+
+    /// Drops a channel. A runner that already took the device is unaffected.
+    pub fn close(&self, handle: u64) {
+        lock(&self.held).remove(&handle);
+    }
+
+    pub fn len(&self) -> usize {
+        lock(&self.held).len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+}
