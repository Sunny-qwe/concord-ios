diff --git a/crates/tun/src/channel.rs b/crates/tun/src/channel.rs
new file mode 100644
index 0000000..838b396
--- /dev/null
+++ b/crates/tun/src/channel.rs
@@ -0,0 +1,187 @@
+//! A channel-backed device for driving the stack without a TUN interface,
+//! in production code. This is the `FakeDevice`/`FakeNet` shape of
+//! `testing.rs`, promoted out of the test gate: packets arrive from the host
+//! through `ChannelNet::inject` and leave through `ChannelNet::take`, with
+//! no file descriptor anywhere. The iOS host (`NEPacketTunnelProvider`)
+//! feeds it with `concord_packet_write` and drains it with
+//! `concord_packet_read` (see `crates/ffi/src/abi.rs`).
+//!
+//! Unlike `testing.rs`, this module has no batching/offload/queue variants:
+//! one device, one ring pair, the smallest surface that carries packets.
+//! `testing.rs` keeps its own copy for tests; the two are intentionally not
+//! shared, so production never depends on test-gated code.
+
+use std::future::poll_fn;
+use std::io;
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll};
+
+use concord_common::sync::lock;
+use futures_util::task::AtomicWaker;
+
+use crate::device::Device;
+
+/// How many packets each direction holds before `inject`/`poll_send` report
+/// full. 64 slots of up to 64 KiB is ~8 MiB worst case for both rings; the
+/// NetworkExtension memory budget is tight, so this stays small. A full ring
+/// drops the packet (`inject` returns `false`) rather than growing.
+pub const CHANNEL_SLOTS: usize = 64;
+/// Largest single packet: an IPv6 jumbogram-free maximum. Packets longer
+/// than this are truncated on `push`, as in `testing.rs`.
+pub const CHANNEL_SLOT_SIZE: usize = 65_535;
+
+struct Ring {
+    slots: Vec<Box<[u8]>>,
+    lens: Vec<usize>,
+    head: usize,
+    count: usize,
+}
+
+impl Ring {
+    fn new(slots: usize, slot_size: usize) -> Self {
+        Ring {
+            slots: (0..slots)
+                .map(|_| vec![0u8; slot_size].into_boxed_slice())
+                .collect(),
+            lens: vec![0; slots],
+            head: 0,
+            count: 0,
+        }
+    }
+
+    fn push(&mut self, packet: &[u8]) -> bool {
+        if self.count == self.slots.len() {
+            return false;
+        }
+        let index = (self.head + self.count) % self.slots.len();
+        let (Some(slot), Some(len)) = (self.slots.get_mut(index), self.lens.get_mut(index)) else {
+            return false;
+        };
+        let n = packet.len().min(slot.len());
+        if let (Some(target), Some(source)) = (slot.get_mut(..n), packet.get(..n)) {
+            target.copy_from_slice(source);
+        }
+        *len = n;
+        self.count += 1;
+        true
+    }
+
+    fn pop(&mut self, out: &mut [u8]) -> Option<usize> {
+        if self.count == 0 {
+            return None;
+        }
+        let slot = self.slots.get(self.head)?;
+        let len = *self.lens.get(self.head)?;
+        let n = len.min(out.len());
+        out.get_mut(..n)?.copy_from_slice(slot.get(..n)?);
+        self.head = (self.head + 1) % self.slots.len();
+        self.count -= 1;
+        Some(n)
+    }
+}
+
+struct Inner {
+    to_stack: Mutex<Ring>,
+    from_stack: Mutex<Ring>,
+    stack_rx: AtomicWaker,
+    stack_tx: AtomicWaker,
+    host_rx: AtomicWaker,
+}
+
+/// What the stack runs on.
+pub struct ChannelDevice {
+    inner: Arc<Inner>,
+}
+
+/// The host's end: writes packets the stack will read, and reads what it wrote.
+#[derive(Clone)]
+pub struct ChannelNet {
+    inner: Arc<Inner>,
+}
+
+/// Neither end allocates after this returns.
+pub fn channel_pair() -> (ChannelDevice, ChannelNet) {
+    channel_pair_with(CHANNEL_SLOTS, CHANNEL_SLOT_SIZE)
+}
+
+/// As `channel_pair`, with explicit ring sizes (tests and the macOS harness).
+pub fn channel_pair_with(slots: usize, slot_size: usize) -> (ChannelDevice, ChannelNet) {
+    let inner = Arc::new(Inner {
+        to_stack: Mutex::new(Ring::new(slots, slot_size)),
+        from_stack: Mutex::new(Ring::new(slots, slot_size)),
+        stack_rx: AtomicWaker::new(),
+        stack_tx: AtomicWaker::new(),
+        host_rx: AtomicWaker::new(),
+    });
+    (
+        ChannelDevice {
+            inner: Arc::clone(&inner),
+        },
+        ChannelNet { inner },
+    )
+}
+
+impl Device for ChannelDevice {
+    fn poll_recv(&self, cx: &mut Context<'_>, buf: &mut [u8]) -> Poll<io::Result<usize>> {
+        self.inner.stack_rx.register(cx.waker());
+        match lock(&self.inner.to_stack).pop(buf) {
+            Some(n) => Poll::Ready(Ok(n)),
+            None => Poll::Pending,
+        }
+    }
+
+    fn poll_send(&self, cx: &mut Context<'_>, packet: &[u8]) -> Poll<io::Result<usize>> {
+        self.inner.stack_tx.register(cx.waker());
+        if lock(&self.inner.from_stack).push(packet) {
+            self.inner.host_rx.wake();
+            Poll::Ready(Ok(packet.len()))
+        } else {
+            Poll::Pending
+        }
+    }
+}
+
+impl ChannelNet {
+    /// `false` when the ring is full; the packet is dropped.
+    pub fn inject(&self, packet: &[u8]) -> bool {
+        let pushed = lock(&self.inner.to_stack).push(packet);
+        self.inner.stack_rx.wake();
+        pushed
+    }
+
+    /// Non-blocking drain: `None` when no packet is waiting.
+    pub fn try_take(&self, out: &mut [u8]) -> Option<usize> {
+        let taken = lock(&self.inner.from_stack).pop(out);
+        if taken.is_some() {
+            self.inner.stack_tx.wake();
+        }
+        taken
+    }
+
+    /// Waits for a packet the stack wrote, then copies it into `out`.
+    pub async fn take(&self, out: &mut [u8]) -> usize {
+        poll_fn(|cx| {
+            self.inner.host_rx.register(cx.waker());
+            match self.try_take(out) {
+                Some(n) => Poll::Ready(n),
+                None => Poll::Pending,
+            }
+        })
+        .await
+    }
+
+    /// Waits for a packet and returns it owned.
+    pub async fn take_vec(&self) -> Vec<u8> {
+        let mut buf = vec![0u8; CHANNEL_SLOT_SIZE];
+        let n = self.take(&mut buf).await;
+        buf.truncate(n);
+        buf
+    }
+
+    /// How many packets are queued for the stack / for the host. Diagnostics only.
+    pub fn queued(&self) -> (usize, usize) {
+        let to_stack = lock(&self.inner.to_stack).count;
+        let from_stack = lock(&self.inner.from_stack).count;
+        (to_stack, from_stack)
+    }
+}
