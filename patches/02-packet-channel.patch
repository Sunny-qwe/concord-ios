diff --git a/crates/ffi/src/abi.rs b/crates/ffi/src/abi.rs
index 06d33c3..4ae4534 100644
--- a/crates/ffi/src/abi.rs
+++ b/crates/ffi/src/abi.rs
@@ -82,3 +82,59 @@ pub extern "C" fn concord_adopt_fd(fd: i32) -> u64 {
     let fd = unsafe { OwnedFd::from_raw_fd(fd) };
     guarded(move || hub().map_or(0, |hub| hub.adopt_fd(fd)))
 }
+
+/// Creates a packet channel (Option B) and returns its handle, or 0 when the
+/// core is not up. The handle is what `tun.start` names as
+/// `{"kind":"channel","handle":…}`; packets flow through
+/// `concord_packet_write` / `concord_packet_read` until
+/// `concord_packet_channel_close`.
+#[unsafe(no_mangle)]
+pub extern "C" fn concord_packet_channel_open() -> u64 {
+    guarded(|| hub().map_or(0, |hub| hub.packet_channel_open()))
+}
+
+/// Writes one IP packet (bare, no utun header) into the channel for the stack
+/// to read. Returns 1 when queued, 0 when the ring is full (retry the packet),
+/// -1 when the handle is unknown or the core is not up.
+///
+/// # Safety
+/// `data` must point to `len` readable bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn concord_packet_write(handle: u64, data: *const u8, len: usize) -> i32 {
+    let packet = if len == 0 {
+        Vec::new()
+    } else {
+        // SAFETY: forwarded from this function's contract.
+        unsafe { std::slice::from_raw_parts(data, len) }.to_vec()
+    };
+    guarded(move || hub().map_or(-1, |hub| hub.packet_write(handle, &packet)))
+}
+
+/// Reads one packet the stack wrote, non-blocking, into `buf`. Returns the
+/// byte count, 0 when no packet is waiting, -1 when the handle is unknown,
+/// the core is not up, or `buf` is null. Poll from the host's pump loop.
+///
+/// # Safety
+/// `buf` must point to `cap` writable bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn concord_packet_read(handle: u64, buf: *mut u8, cap: usize) -> i32 {
+    if buf.is_null() {
+        return -1;
+    }
+    guarded(move || {
+        hub().map_or(-1, |hub| {
+            // SAFETY: `buf` was checked non-null and `cap` is its capacity.
+            hub.packet_read(handle, unsafe { std::slice::from_raw_parts_mut(buf, cap) })
+        })
+    })
+}
+
+/// Drops a packet channel. A runner that already took the device is unaffected.
+#[unsafe(no_mangle)]
+pub extern "C" fn concord_packet_channel_close(handle: u64) {
+    guarded(|| {
+        if let Some(hub) = hub() {
+            hub.packet_channel_close(handle);
+        }
+    });
+}
