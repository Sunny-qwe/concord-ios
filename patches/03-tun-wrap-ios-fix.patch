From 3b8e7c9b9d2a7bc3d3fff92db0e57d649b08b5b0 Mon Sep 17 00:00:00 2001
From: rebase <rebase@local>
Date: Wed, 25 Nov 2026 07:29:10 +0000
Subject: [PATCH 3/8] ios: cfg-gate TunDevice::wrap name/index lookup off iOS

---
 crates/tun/src/device/mod.rs | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/crates/tun/src/device/mod.rs b/crates/tun/src/device/mod.rs
index a83cc78..777ce05 100644
--- a/crates/tun/src/device/mod.rs
+++ b/crates/tun/src/device/mod.rs
@@ -327,9 +327,16 @@ impl TunDevice {
     }
 
     fn wrap(inner: tun_rs::AsyncDevice) -> Self {
-        #[cfg(not(target_os = "android"))]
+        // `name()` / `if_index()` exist only on the linux/macos/windows/
+        // freebsd/openbsd/netbsd device impls. The generic unix impl (used on
+        // iOS and illumos, `vendor/tun-rs/src/platform/mod.rs`: "A TUN device
+        // for Android/iOS/…") defines neither, so reading them there does not
+        // compile for `aarch64-apple-ios`. A channel or an adopted socket fd
+        // has no interface name anyway; the empty name / `None` index is what
+        // the Android path already uses, and routes are a no-op on iOS.
+        #[cfg(not(any(target_os = "android", target_os = "ios", target_os = "illumos")))]
         let (name, index) = (inner.name().unwrap_or_default(), inner.if_index().ok());
-        #[cfg(target_os = "android")]
+        #[cfg(any(target_os = "android", target_os = "ios", target_os = "illumos"))]
         let (name, index) = (String::new(), None);
         TunDevice {
             inner: DeviceIo::Tokio(inner),
-- 
