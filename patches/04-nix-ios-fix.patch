+    /// leading NUL byte. `None` is returned for unnamed or path-backed sockets.
+    #[cfg(linux_android)]
+    pub fn as_abstract(&self) -> Option<&[u8]> {
+        match self.kind() {
+            UnixAddrKind::Abstract(name) => Some(name),
+            _ => None,
+        }
+    }
