+            .expect("send socket failed");
+
+            let mut num_packets_received: i32 = 0;
+
+            sendrecv(
+                rsock.as_raw_fd(),
+                ssock.as_raw_fd(),
+                move |s, m, flags| {
+                    let iov = [IoSlice::new(m)];
+                    let cmsg = ControlMessage::UdpGsoSegments(&segment_size);
