+            &mut pid as *mut libc::pid_t,
+            path.as_ptr(),
+            &file_actions.fa as *const libc::posix_spawn_file_actions_t,
+            &attr.attr as *const libc::posix_spawnattr_t,
+            args_p.as_ptr(),
+            env_p.as_ptr(),
+        )
+    };
