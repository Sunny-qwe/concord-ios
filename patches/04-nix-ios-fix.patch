+/// Manipulates file space.
+///
+/// Allows the caller to directly manipulate the allocated disk space for the
+/// file referred to by fd.
+#[cfg(target_os = "linux")]
+#[cfg(feature = "fs")]
+pub fn fallocate<Fd: std::os::fd::AsFd>(
+    fd: Fd,
