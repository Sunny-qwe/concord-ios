+    PIPE_BUF = libc::_PC_PIPE_BUF,
+    #[cfg(any(
+        linux_android,
+        solarish,
+        netbsdlike,
+        target_os = "dragonfly",
+        target_os = "redox",
+    ))]
+    /// Symbolic links can be created.
+    POSIX2_SYMLINKS = libc::_PC_2_SYMLINKS,
+    #[cfg(any(
+        linux_android,
+        freebsdlike,
+        target_os = "openbsd",
+        target_os = "redox"
+    ))]
+    /// Minimum number of bytes of storage actually allocated for any portion of
+    /// a file.
