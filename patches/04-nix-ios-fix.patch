+/// Splice user pages to/from a pipe
+///
+/// # See Also
+/// *[`vmsplice`](https://man7.org/linux/man-pages/man2/vmsplice.2.html)
+#[cfg(linux_android)]
+pub fn vmsplice<F: std::os::fd::AsFd>(
+    fd: F,
+    iov: &[std::io::IoSlice<'_>],
+    flags: SpliceFFlags,
+) -> Result<usize> {
+    use std::os::fd::AsRawFd;
+
+    let ret = unsafe {
+        libc::vmsplice(
+            fd.as_fd().as_raw_fd(),
+            iov.as_ptr().cast(),
+            iov.len(),
+            flags.bits(),
+        )
+    };
+    Errno::result(ret).map(|r| r as usize)
+}
