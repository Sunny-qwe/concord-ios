+            /// advantageous.
+            POSIX_FADV_RANDOM,
+            /// The specified data will only be accessed once and then not reused.
+            POSIX_FADV_NOREUSE,
+            /// The specified data will be accessed in the near future.
+            POSIX_FADV_WILLNEED,
+            /// The specified data will not be accessed in the near future.
+            POSIX_FADV_DONTNEED,
+        }
