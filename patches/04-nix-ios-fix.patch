+pub fn mknodat<Fd: std::os::fd::AsFd, P: ?Sized + NixPath>(
+    dirfd: Fd,
+    path: &P,
+    kind: SFlag,
+    perm: Mode,
+    dev: dev_t,
+) -> Result<()> {
+    use std::os::fd::AsRawFd;
+
+    let res = path.with_nix_path(|cstr| unsafe {
+        libc::mknodat(
+            dirfd.as_fd().as_raw_fd(),
+            cstr.as_ptr(),
+            kind.bits() | perm.bits() as mode_t,
+            dev,
+        )
+    })?;
+
+    Errno::result(res).map(drop)
+}
