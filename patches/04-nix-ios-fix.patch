+#[cfg(any(linux_android, freebsdlike, target_os = "hurd"))]
+#[inline]
+pub fn fexecve<Fd: std::os::fd::AsFd, SA: AsRef<CStr>, SE: AsRef<CStr>>(
+    fd: Fd,
+    args: &[SA],
+    env: &[SE],
+) -> Result<Infallible> {
+    use std::os::fd::AsRawFd;
+
+    let args_p = to_exec_array(args);
+    let env_p = to_exec_array(env);
