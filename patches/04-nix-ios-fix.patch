+    path: &CStr,
+    file_actions: &PosixSpawnFileActions,
+    attr: &PosixSpawnAttr,
+    args: &[SA],
+    envp: &[SE],
+) -> Result<Pid> {
+    let mut pid = 0;
+
+    let ret = unsafe {
+        let args_p = to_exec_array(args);
+        let env_p = to_exec_array(envp);
