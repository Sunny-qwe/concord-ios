+    let old_dirfd =
+        open(old_dir.path(), OFlag::empty(), Mode::empty()).unwrap();
+    let old_path = old_dir.path().join("old");
+    File::create(old_path).unwrap();
+    let new_dir = tempfile::tempdir().unwrap();
