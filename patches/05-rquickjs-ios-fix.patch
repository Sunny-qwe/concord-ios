From 384521f23c2933eccbcef575ab23160184846255 Mon Sep 17 00:00:00 2001
From: Muse <muse@local>
Date: Tue, 17 Nov 2026 08:34:06 +0000
Subject: [PATCH 5/7] mitm: enable rquickjs bindgen feature for iOS (no
 pre-generated bindings)

---
 crates/mitm/Cargo.toml | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/crates/mitm/Cargo.toml b/crates/mitm/Cargo.toml
index 32b7f93..3a7194c 100644
--- a/crates/mitm/Cargo.toml
+++ b/crates/mitm/Cargo.toml
@@ -57,6 +57,17 @@ rquickjs = { workspace = true, optional = true }
 [target.'cfg(target_os = "android")'.dependencies]
 rquickjs = { workspace = true, optional = true, features = ["bindgen"] }
 
+# iOS, like Android, has no pre-generated rquickjs-sys bindings
+# (src/bindings/ ships darwin/linux/windows/wasm only), so generate them
+# at build time. bindgen finds Xcode's libclang itself (clang-sys
+# searches `xcode-select --print-path`/Toolchains/...). Pass the iPhoneOS
+# SDK to bindgen with BINDGEN_EXTRA_CLANG_ARGS_aarch64_apple_ios, as
+# upstream CI does for Android
+# (ci.yaml, BINDGEN_EXTRA_CLANG_ARGS_aarch64_linux_android), so the
+# bindings are parsed against the iOS headers rather than the macOS SDK.
+[target.'cfg(target_os = "ios")'.dependencies]
+rquickjs = { workspace = true, optional = true, features = ["bindgen"] }
+
 [dev-dependencies]
 concord-test-support = { workspace = true }
 tokio = { workspace = true, features = ["full", "test-util"] }
-- 
