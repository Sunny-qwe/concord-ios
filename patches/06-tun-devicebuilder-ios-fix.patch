From 8e07f6d321bb29804068587859e1e19ab8cfaf30 Mon Sep 17 00:00:00 2001
From: rebase <rebase@local>
Date: Fri, 27 Nov 2026 02:07:37 +0000
Subject: [PATCH 06/10] ios: gate TunDevice::create off iOS with Unsupported stub

---
 crates/tun/src/device/mod.rs | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/crates/tun/src/device/mod.rs b/crates/tun/src/device/mod.rs
index 777ce05..81c6b50 100644
--- a/crates/tun/src/device/mod.rs
+++ b/crates/tun/src/device/mod.rs
@@ -227,7 +227,13 @@ impl TunDevice {
 
     /// Creates the interface with the first address of each family; further addresses are
     /// not configured.
-    #[cfg(not(target_os = "android"))]
+    ///
+    /// Not available on Android or iOS: the host owns the interface there
+    /// and hands the core packets or a descriptor instead (see the stub
+    /// below). `tun-rs` has no device-creation path on those targets at
+    /// all — its `DeviceBuilder` is not compiled for them — so there is
+    /// nothing `build` could call.
+    #[cfg(not(any(target_os = "android", target_os = "ios")))]
     pub fn create(options: &TunOptions) -> io::Result<Self> {
         #[cfg(target_os = "linux")]
         match Self::build(options, true) {
@@ -239,7 +245,7 @@ impl TunDevice {
         Self::build(options, false)
     }
 
-    #[cfg(not(target_os = "android"))]
+    #[cfg(not(any(target_os = "android", target_os = "ios")))]
     #[cfg_attr(
         not(target_os = "linux"),
         allow(unused_variables, reason = "offload is Linux-only")
@@ -314,6 +320,17 @@ impl TunDevice {
         ))
     }
 
+    /// The NetworkExtension owns the interface; the core gets packets
+    /// through the packet channel or an adopted descriptor, never by
+    /// creating a device.
+    #[cfg(target_os = "ios")]
+    pub fn create(_options: &TunOptions) -> io::Result<Self> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "the NetworkExtension owns the interface; use the packet channel or adopt its descriptor",
+        ))
+    }
+
     /// Adopts the descriptor of a `VpnService` interface. The descriptor is closed on every
     /// failure path, including the ones before tun-rs takes it over.
     #[cfg(unix)]
-- 
2.43.0

