From 54d8b47099d5811fad5bf681696c7ad5152ab5df Mon Sep 17 00:00:00 2001
From: rebase <rebase@local>
Date: Fri, 27 Nov 2026 02:07:37 +0000
Subject: [PATCH 07/10] ios: drop SOCK_CLOEXEC on Apple targets

---
 bins/ios/src/bridge.rs | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/bins/ios/src/bridge.rs b/bins/ios/src/bridge.rs
index 594ba1e..a356c7b 100644
--- a/bins/ios/src/bridge.rs
+++ b/bins/ios/src/bridge.rs
@@ -94,15 +94,16 @@ pub unsafe extern "C" fn concord_ios_bridge_open(host_fd: *mut c_int, handle: *m
     let mut pair = [-1 as c_int, -1 as c_int];
     // SOCK_DGRAM preserves datagram boundaries: one send = one IP packet on
     // the core side (see the module docs, caveat (i)). SOCK_CLOEXEC so the
-    // fds do not leak into any spawned process.
-    let made = unsafe {
-        libc::socketpair(
-            libc::AF_UNIX,
-            libc::SOCK_DGRAM | libc::SOCK_CLOEXEC,
-            0,
-            pair.as_mut_ptr(),
-        )
-    };
+    // fds do not leak into any spawned process — but libc has no
+    // SOCK_CLOEXEC on Apple targets (E0425), so there it is just
+    // SOCK_DGRAM; the fds stay in-process (one end is adopted by the core,
+    // the other is held by the extension), so nothing can leak them into a
+    // spawned process anyway.
+    #[cfg(not(target_vendor = "apple"))]
+    let socktype = libc::SOCK_DGRAM | libc::SOCK_CLOEXEC;
+    #[cfg(target_vendor = "apple")]
+    let socktype = libc::SOCK_DGRAM;
+    let made = unsafe { libc::socketpair(libc::AF_UNIX, socktype, 0, pair.as_mut_ptr()) };
     if made != 0 {
         return -1;
     }
