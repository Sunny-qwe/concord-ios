From e2fb43e0000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rebase <rebase@local>
Date: Thu, 26 Nov 2026 10:00:00 +0000
Subject: [PATCH 9/9] ios: read resident memory on iOS via proc_pidinfo

---
 crates/platform/src/mem.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/crates/platform/src/mem.rs b/crates/platform/src/mem.rs
index 14f72b1..7f6a1f4 100644
--- a/crates/platform/src/mem.rs
+++ b/crates/platform/src/mem.rs
@@ -15,7 +15,7 @@ pub fn resident_memory() -> u64 {
         .unwrap_or(0)
 }
 
-#[cfg(target_os = "macos")]
+#[cfg(any(target_os = "macos", target_os = "ios"))]
 pub fn resident_memory() -> u64 {
     let size = std::mem::size_of::<libc::proc_taskinfo>() as libc::c_int;
     // SAFETY: all-zero is a valid `proc_taskinfo`, and the kernel fills at most `size` bytes.
@@ -56,6 +56,7 @@ pub fn resident_memory() -> u64 {
     target_os = "linux",
     target_os = "android",
     target_os = "macos",
+    target_os = "ios",
     windows
 )))]
 pub fn resident_memory() -> u64 {
