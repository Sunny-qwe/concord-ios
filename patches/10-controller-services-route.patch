+    /// Service availability through the core's own prober
+    /// (`probe.services`): each check is pinned to `proxy`, exactly
+    /// like FlClash's `checkServices` — an empty `proxy` lets the
+    /// core route by its rules, an empty `names` runs every check,
+    /// and an absent `timeout` keeps the core's 10 s default
+    /// (services.rs `DEFAULT_PROBE_TIMEOUT`, concurrency 4, sweep
+    /// budget 6x). The answer is the RPC result's own JSON
+    /// (`{"items": [...]}`), so a host that already decodes
+    /// `probe.services` reads this route with no model change.
+    async fn services(&self, request: &Request<Incoming>) -> Response<Body> {
+        let proxy = query(request.uri(), "proxy").unwrap_or_default();
+        let names = query(request.uri(), "names")
+            .map(|names| {
+                names
+                    .split(',')
+                    .map(|name| name.to_owned())
+                    .filter(|name| !name.is_empty())
+                    .collect()
+            })
+            .unwrap_or_default();
+        let timeout = match query(request.uri(), "timeout") {
+            None => None,
+            Some(text) => match text.parse::<u64>() {
+                Ok(timeout) => Some(timeout),
+                Err(_) => return bad_request(),
+            },
+        };
+        let params = ServicesParams {
+            proxy,
+            names,
+            timeout,
+        };
+        match self.control.probe_services(params).await {
+            Ok(list) => json(&list),
+            Err(err) => error(StatusCode::BAD_GATEWAY, &err.message),
+        }
+    }
+
